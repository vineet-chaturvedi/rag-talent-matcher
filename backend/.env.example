# ---------- App ----------
APP_NAME="RAG Talent Matcher"
ENVIRONMENT=development        # development | production (dev endpoints are disabled in production)
LOG_LEVEL=INFO                 # DEBUG shows more detail

# ---------- Ollama and the models ----------
# Any Ollama model works: `ollama pull <name>`, put the name here, restart the server. Nothing else changes.
# Cloud models (Claude, GPT, Gemini, Voyage, Cohere ...) work too: see "Cloud and other model providers" below.
# Model-specific details (embedding prompts, "thinking", vector sizes) are handled in app/llm/models.py.
# Then measure: python -m scripts.evaluate_all --note "<what you changed>"  (doc 19)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=300     # CPU generation is slow; allow up to 5 minutes
EMBED_MODEL=nomic-embed-text   # or qwen3-embedding:0.6b, embeddinggemma, mxbai-embed-large, bge-m3 ...
FAST_LLM_MODEL=qwen3.5:4b      # the quick model, e.g. qwen3.5:4b (Apache 2.0)
QUALITY_LLM_MODEL=qwen3.5:9b   # the careful model, e.g. qwen3.5:9b
LLM_NUM_CTX=8192               # context window; too small = prompt silently cut off
LLM_THINK=off                  # off | on | default: step-by-step "thinking" (qwen3.x, deepseek-r1); off = fast on CPU
# After changing EMBED_MODEL, resumes embedded with the old model are re-embedded at the next start.
AUTO_REEMBED_ON_MODEL_CHANGE=true
# Only for an embedding model app/llm/models.py doesn't know (the server log warns you): the text its model
# card says to put around a query / a stored document, with {text} where the text goes. Empty = automatic.
EMBED_QUERY_TEMPLATE=
EMBED_DOCUMENT_TEMPLATE=

# ---------- Cloud and other model providers (doc 20) ----------
# A model setting "<provider>/<model>" runs at that provider instead of Ollama, e.g.
#   QUALITY_LLM_MODEL=anthropic/claude-sonnet-4-5     FAST_LLM_MODEL=openai/gpt-4.1-mini
#   AGENT_MODEL_ROLE=gemini/gemini-2.5-flash           EMBED_MODEL=openai/text-embedding-3-large
#   EMBED_MODEL=voyage/voyage-3.5   EMBED_MODEL=cohere/embed-v4.0   EMBED_MODEL=gemini/gemini-embedding-001
#   QUALITY_LLM_MODEL=azure/<your deployment name>     QUALITY_LLM_MODEL=compat/<model on your vLLM / LM Studio / gateway>
# Needs: pip install -r requirements-cloud.txt. Only the providers you actually use need a key.
# Resumes are personal data: models outside this computer/network are refused until this is true
# (decide it after checking the provider's data-processing terms and the law: DPDP Act, GDPR).
ALLOW_CLOUD_MODELS=false
CLOUD_TIMEOUT_SECONDS=120
OPENAI_API_KEY=
# empty = api.openai.com
OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
# https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
ANTHROPIC_API_KEY=
ANTHROPIC_MAX_TOKENS=4096        # Claude needs a limit when a task sets none
GEMINI_API_KEY=
# any OpenAI-compatible server, e.g. http://localhost:8000/v1 (vLLM) or OpenRouter
COMPAT_BASE_URL=
COMPAT_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=
# API embeddings that can shorten vectors (OpenAI -3, Voyage, Cohere, Gemini), e.g. 1024
EMBED_DIMENSIONS=

# ---------- Database ----------
DATABASE_URL=sqlite+aiosqlite:///./data/app.db   # file path is relative to backend/
DB_ECHO=false                                     # true = print every SQL statement

# ---------- Uploads & ingestion ----------
UPLOAD_DIR=./data/uploads      # where resume files are stored (git-ignored)
MAX_UPLOAD_MB=25               # per file (Word files with embedded fonts reach 12+ MB)
MAX_FILES_PER_BATCH=200        # per bulk upload request
WORKER_ENABLED=true            # background processing on/off
WORKER_POLL_SECONDS=5          # idle worker re-checks the queue this often
WORKER_MAX_ATTEMPTS=3          # retries for unexpected errors
MIN_CHARS_PER_PAGE=100         # below this a PDF page is treated as a scanned image
OLLAMA_RETRY_SECONDS=30        # if Ollama is down, the worker waits this long and tries again

# ---------- Structured extraction (Step 5) ----------
EXTRACTION_MODEL_ROLE=fast     # fast | quality | any model name: compare_extraction showed 3B = 13/14 at half the time of 7B
EXTRACTION_MAX_OUTPUT_TOKENS=2048   # hard cap on the JSON answer
EXTRACTION_MAX_INPUT_CHARS=16000    # ~4,000 tokens per model call; longer resumes are read in parts

# ---------- Chunking, embeddings & vector store (Step 6) ----------
CHROMA_DIR=./data/chroma       # ChromaDB files (git-ignored; can always be rebuilt from SQLite)
CHROMA_COLLECTION=resume_chunks
CHUNK_MAX_CHARS=1200           # ~300 tokens per chunk
CHUNK_OVERLAP_CHARS=150        # text repeated between neighbouring chunks
EMBED_BATCH_SIZE=16            # chunks per Ollama /api/embed call
ANONYMIZE_CHUNKS=true          # remove name, email, phone from indexed text

# ---------- Role parsing & hybrid retrieval (Step 7) ----------
ROLE_PARSE_MODEL_ROLE=quality  # fast | quality | any model name: which LLM reads role descriptions (one call per role, so quality is affordable)
RETRIEVAL_VECTOR_POOL=80       # chunks fetched from ChromaDB per search (several chunks per person)
RETRIEVAL_KEYWORD_POOL=200     # chunks fetched from the FTS5 keyword index per search
RRF_K=60                       # Reciprocal Rank Fusion constant (60 is the standard value)
RRF_WEIGHT_SKILLS=1.0          # how much each signal counts when fusing (1.0 = equal)
RRF_WEIGHT_KEYWORD=1.0
RRF_WEIGHT_VECTOR=1.0
# Optional reranker (Step 13b): empty = off. Try Xenova/ms-marco-MiniLM-L-6-v2 after `pip install fastembed`,
# and keep it only if `python -m scripts.evaluate_real_retrieval --compare-rerank` shows it helps.
RERANK_MODEL=
RERANK_POOL=30
RRF_WEIGHT_RERANK=1.0
DEFAULT_SKILL_MIN_YEARS=2.0    # years assumed "enough" for a must-have skill when the role gives none

# ---------- Scoring & LLM judge (Step 8) ----------
SCORE_SKILLS_SHARE=0.85        # fit = share x skill coverage + rest x retrieval relevance
SCORE_EXPERIENCE_FLOOR=0.6     # not enough years lowers the score by up to 40%
SCORE_AVAILABILITY_FLOOR=0.7   # not free in time lowers it by up to 30%
SCORE_LOCATION_FLOOR=0.9       # another city lowers it by up to 10%
JUDGE_MODEL_ROLE=quality       # fast | quality | any model name: which LLM judges the top candidates
JUDGE_TOP_N=5                  # candidates judged per run
JUDGE_WEIGHT=0.4               # final = 0.6 x rule score + 0.4 x judge score
JUDGE_MAX_OUTPUT_TOKENS=1024
JUDGE_MAX_DOSSIER_CHARS=6000   # ~1,500 tokens of resume text per candidate

# ---------- Agent (Step 10) ----------
AGENT_MODEL_ROLE=quality       # fast | quality | any model name: tool use needs the better model (try fast and compare)
AGENT_MAX_STEPS=4              # tool rounds per question before the agent must answer
AGENT_TEMPERATURE=0            # 0 = most predictable tool choices
AGENT_MAX_OUTPUT_TOKENS=1024   # cap on one reply
AGENT_HISTORY_MESSAGES=10      # earlier questions/answers sent as short-term memory
AGENT_TOOL_RESULT_CHARS=6000   # tool results longer than this are cut (protects the context window)

# ---------- Authentication (Step 9) ----------
# JWT_SECRET signs login tokens. Generate one with:  python -m scripts.create_user --secret
# Without it (development only) a random secret is used and everyone is logged out when the server restarts.
# Keep it secret: anyone who knows it can create valid logins. Never commit the real value to git.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=480       # how long a login lasts (480 = one working day)
AUTH_COOKIE_NAME=rtm_access    # HttpOnly cookie used by the browser frontend

# ---------- Frontend ----------
CORS_ORIGINS=["http://localhost:3000"]
