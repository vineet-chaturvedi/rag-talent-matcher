# ---------- App ----------
APP_NAME="RAG Talent Matcher"
ENVIRONMENT=development        # development | production (dev endpoints are disabled in production)
LOG_LEVEL=INFO                 # DEBUG shows more detail

# ---------- Ollama ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=300     # CPU generation is slow; allow up to 5 minutes
EMBED_MODEL=nomic-embed-text
FAST_LLM_MODEL=qwen2.5:3b      # agent chat (swap to llama3.2:3b for commercial use)
QUALITY_LLM_MODEL=qwen2.5:7b   # resume extraction + judging
LLM_NUM_CTX=8192               # context window; too small = prompt silently cut off

# ---------- Database ----------
DATABASE_URL=sqlite+aiosqlite:///./data/app.db   # file path is relative to backend/
DB_ECHO=false                                     # true = print every SQL statement

# ---------- Uploads & ingestion ----------
UPLOAD_DIR=./data/uploads      # where resume files are stored (git-ignored)
MAX_UPLOAD_MB=10               # per file
MAX_FILES_PER_BATCH=200        # per bulk upload request
WORKER_ENABLED=true            # background processing on/off
WORKER_POLL_SECONDS=5          # idle worker re-checks the queue this often
WORKER_MAX_ATTEMPTS=3          # retries for unexpected errors
MIN_CHARS_PER_PAGE=100         # below this a PDF page is treated as a scanned image
OLLAMA_RETRY_SECONDS=30        # if Ollama is down, the worker waits this long and tries again

# ---------- Structured extraction (Step 5) ----------
EXTRACTION_MODEL_ROLE=fast     # fast | quality: compare_extraction showed 3B = 13/14 at half the time of 7B
EXTRACTION_MAX_OUTPUT_TOKENS=2048   # hard cap on the JSON answer
EXTRACTION_MAX_INPUT_CHARS=16000    # ~4,000 tokens; longer resumes are truncated with a warning

# ---------- Chunking, embeddings & vector store (Step 6) ----------
CHROMA_DIR=./data/chroma       # ChromaDB files (git-ignored; can always be rebuilt from SQLite)
CHROMA_COLLECTION=resume_chunks
CHUNK_MAX_CHARS=1200           # ~300 tokens per chunk
CHUNK_OVERLAP_CHARS=150        # text repeated between neighbouring chunks
EMBED_BATCH_SIZE=16            # chunks per Ollama /api/embed call
ANONYMIZE_CHUNKS=true          # remove name, email, phone from indexed text

# ---------- Role parsing & hybrid retrieval (Step 7) ----------
ROLE_PARSE_MODEL_ROLE=quality  # fast | quality: which LLM reads role descriptions (one call per role, so quality is affordable)
RETRIEVAL_VECTOR_POOL=80       # chunks fetched from ChromaDB per search (several chunks per person)
RETRIEVAL_KEYWORD_POOL=200     # chunks fetched from the FTS5 keyword index per search
RRF_K=60                       # Reciprocal Rank Fusion constant (60 is the standard value)
RRF_WEIGHT_SKILLS=1.0          # how much each signal counts when fusing (1.0 = equal)
RRF_WEIGHT_KEYWORD=1.0
RRF_WEIGHT_VECTOR=1.0
DEFAULT_SKILL_MIN_YEARS=2.0    # years assumed "enough" for a must-have skill when the role gives none

# ---------- Scoring & LLM judge (Step 8) ----------
SCORE_SKILLS_SHARE=0.85        # fit = share x skill coverage + rest x retrieval relevance
SCORE_EXPERIENCE_FLOOR=0.6     # not enough years lowers the score by up to 40%
SCORE_AVAILABILITY_FLOOR=0.7   # not free in time lowers it by up to 30%
SCORE_LOCATION_FLOOR=0.9       # another city lowers it by up to 10%
JUDGE_MODEL_ROLE=quality       # fast | quality: which LLM judges the top candidates
JUDGE_TOP_N=5                  # candidates judged per run
JUDGE_WEIGHT=0.4               # final = 0.6 x rule score + 0.4 x judge score
JUDGE_MAX_OUTPUT_TOKENS=1024
JUDGE_MAX_DOSSIER_CHARS=6000   # ~1,500 tokens of resume text per candidate

# ---------- Authentication (Step 9) ----------
# JWT_SECRET signs login tokens. Generate one with:  python -m scripts.create_user --secret
# Without it (development only) a random secret is used and everyone is logged out when the server restarts.
# Keep it secret: anyone who knows it can create valid logins. Never commit the real value to git.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=480       # how long a login lasts (480 = one working day)
AUTH_COOKIE_NAME=rtm_access    # HttpOnly cookie used by the browser frontend

# ---------- Frontend ----------
CORS_ORIGINS=["http://localhost:3000"]
