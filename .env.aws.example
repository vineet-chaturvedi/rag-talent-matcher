# Settings for the server (doc 22). On the EC2 instance:  cp .env.aws.example .env  then fill in every value.
# Used by:  docker compose -f docker-compose.yml -f docker-compose.aws.yml up -d
# Never commit the filled-in .env (git-ignored).

# ---- Secrets: generate each with   openssl rand -base64 32 | tr -d '/+=' ----
POSTGRES_PASSWORD=
JWT_SECRET=

# ---- Images in ECR (Phase 3) ----
REGISTRY=<account-id>.dkr.ecr.ap-southeast-2.amazonaws.com
IMAGE_TAG=v1

# ---- AWS region and Bedrock models (confirmed in Phase 2: use the ids that answered there) ----
AWS_REGION=ap-southeast-2
FAST_LLM_MODEL=bedrock/amazon.nova-lite-v1:0
QUALITY_LLM_MODEL=bedrock/amazon.nova-pro-v1:0
EMBED_MODEL=bedrock/amazon.titan-embed-text-v2:0
EMBED_DIMENSIONS=1024

# ---- Optional ----
# WORKER_CONCURRENCY=2              # resumes processed at once by the worker
# ENVIRONMENT=production
