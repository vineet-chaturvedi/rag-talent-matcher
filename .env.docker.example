# Settings for docker-compose.yml (copy to .env next to it: `cp .env.docker.example .env`).
# Models, providers, storage and queue settings stay in backend/.env, as without Docker.

# Required: choose your own. Generate strong values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
JWT_SECRET=

# Optional
# POSTGRES_USER=rag
# POSTGRES_DB=rag
# ENVIRONMENT=production            # development shows more detail in /api/health and enables dev tools
# OLLAMA_BASE_URL=http://host.docker.internal:11434   # Ollama on this PC (it must listen on all addresses:
#                                                     # set OLLAMA_HOST=0.0.0.0 for Ollama, see doc 21)
# OLLAMA_BASE_URL=http://ollama:11434                 # with `docker compose --profile ollama up -d`
# PORTAL_PORT=3000
# API_PORT=8010
# POSTGRES_PORT=5432
# HTTPS=false                       # true when the portal is served over HTTPS (secure cookies, HSTS)
# IMAGE_TAG=latest
