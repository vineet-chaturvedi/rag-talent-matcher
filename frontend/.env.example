# Copy to .env.local and adjust. Next.js reads .env.local automatically (it is git-ignored).
# All of these are read by the Next.js SERVER only; none has a NEXT_PUBLIC_ prefix, so none is
# ever sent to the browser. src/lib/env/schema.ts checks them at startup.

# Where the FastAPI backend runs.
BACKEND_URL=http://127.0.0.1:8010

# true only when the portal is served over HTTPS (Secure cookies, HSTS, upgrade-insecure-requests).
HTTPS=false
